# Data and checkpoints are fetched by scripts/00_environment.py and verified by
# checksum; they are never committed. See results/manifests/ for their provenance.
data/
models/
third_party/

# Raw experiment output IS committed (3.5 MB of jsonl): the checklist claims every
# quantitative claim traces to a committed record, and that has to be true rather
# than aspirational. Only the bulky binary artifacts below stay out.
results/profile/
*.nsys-rep
*.ncu-rep
*.sqlite
*.qdrep

__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Built supplement archive (regenerate with scripts/10_supplement.py)
supplement_anonymous.zip

# LaTeX build artifacts. Regenerated by every pdflatex run, and they churn on each
# build, so tracking them made the workshop-variant commits noisy for no benefit.
# The .tex sources and the submitted .pdf ARE tracked.
paper/*.aux
paper/*.log
paper/*.blg
paper/*.out
paper/*.brf
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
